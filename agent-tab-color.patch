+static bool tokenMatchesAgentName(const QString &token, const QStringList &agents)
+{
+    const QString t = token.trimmed();
+    if (t.isEmpty()) {
+        return false;
+    }
+    for (const QString &agent : agents) {
+        if (agent.isEmpty()) {
+            continue;
+        }
+        if (t.compare(agent, Qt::CaseInsensitive) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool cmdlineMatchesAgent(const QByteArray &rawCmdline, const QStringList &agents)
+{
+    if (rawCmdline.isEmpty()) {
+        return false;
+    }
+    const QList<QByteArray> parts = rawCmdline.split('\0');
+    if (!parts.isEmpty() && !parts.at(0).isEmpty()) {
+        const QString exeBase = QFileInfo(QString::fromLocal8Bit(parts.at(0))).fileName();
+        if (tokenMatchesAgentName(exeBase, agents)) {
+            return true;
+        }
+    }
+    const QString cmd = QString::fromLocal8Bit(rawCmdline.constData(), rawCmdline.size()).toLower().replace(QLatin1Char('\0'), QLatin1Char(' '));
+    for (const QString &agent : agents) {
+        const QString a = agent.trimmed().toLower();
+        if (a.isEmpty()) {
+            continue;
+        }
+        // Cursor's CLI sets comm to "MainThread"; match the real binary in cmdline.
+        if (a == QLatin1String("agent")) {
+            if (cmd.contains(QLatin1String("/agent")) || cmd.contains(QLatin1String("bin/agent"))) {
+                return true;
+            }
+            continue;
+        }
+        if (a.size() <= 3) {
+            continue;
+        }
+        if (cmd.contains(a)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool processMatchesAgent(int pid, const QStringList &agents)
+{
+    QFile statFile(QStringLiteral("/proc/") + QString::number(pid) + QStringLiteral("/stat"));
+    if (statFile.open(QIODevice::ReadOnly)) {
+        const QByteArray data = statFile.readAll();
+        const int start = data.indexOf('(');
+        const int end = data.lastIndexOf(')');
+        if (start >= 0 && end > start) {
+            if (tokenMatchesAgentName(QString::fromLatin1(data.mid(start + 1, end - start - 1)), agents)) {
+                return true;
+            }
+        }
+    }
+    QFile cmdFile(QStringLiteral("/proc/") + QString::number(pid) + QStringLiteral("/cmdline"));
+    if (cmdFile.open(QIODevice::ReadOnly)) {
+        return cmdlineMatchesAgent(cmdFile.readAll(), agents);
+    }
+    return false;
+}
+
+// Any process in the foreground process group (wrappers, node workers, MCP children).
+static bool isAgentInProcessGroup(int pgid, const QStringList &agents)
+{
+    QDirIterator it(QStringLiteral("/proc"), {QStringLiteral("[0-9]*")}, QDir::Dirs);
+    while (it.hasNext()) {
+        const QString path = it.next();
+        const int pid = path.mid(path.lastIndexOf(QLatin1Char('/')) + 1).toInt();
+        if (pid <= 0) {
+            continue;
+        }
+        QFile statFile(path + QStringLiteral("/stat"));
+        if (!statFile.open(QIODevice::ReadOnly)) {
+            continue;
+        }
+        const QByteArray data = statFile.readAll();
+        const int end = data.lastIndexOf(')');
+        const QList<QByteArray> fields = data.mid(end + 2).split(' ');
+        if (fields.size() >= 3 && fields.at(2).toInt() == pgid && processMatchesAgent(pid, agents)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+void SessionController::updateAgentTabColor()
+{
+    if (session().isNull() || !KonsoleSettings::agentDetectionEnabled()) {
+        return;
+    }
+
+    QStringList agents;
+    const auto entries = KonsoleSettings::agentProcessNames().split(QLatin1Char(','), Qt::SkipEmptyParts);
+    for (const QString &entry : entries) {
+        agents.append(entry.trimmed());
+    }
+
+    bool running = false;
+    if (!agents.isEmpty()) {
+        const int pgid = session()->foregroundProcessGroupId();
+        if (pgid != -1) {
+            running = isAgentInProcessGroup(pgid, agents);
+        }
+        if (!running) {
+            const int fpid = session()->foregroundProcessId();
+            if (fpid > 0) {
+                running = processMatchesAgent(fpid, agents);
+            }
+        }
+        if (!running) {
+            running = tokenMatchesAgentName(session()->foregroundProcessName(), agents);
+        }
+    }
+
+    if (session()->isTabColorSetByUser()) {
+        return; // never override a color the user picked manually
+    }
+    const Profile::Ptr profile = SessionManager::instance()->sessionProfile(session());
+    const QColor target = running ? KonsoleSettings::agentTabColor() : (profile ? profile->tabColor() : QColor());
+    if (session()->color() != target) {
+        session()->setColor(target);
+    }
+    if (color() != target) {
+        setColor(target);
+    }
+}
